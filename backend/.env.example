# Adzuna Jobs API (free tier) — https://developer.adzuna.com/
# Copy this file to backend/.env and fill in your own credentials.
# .env is gitignored; never commit real keys.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Adzuna only supports a fixed set of country codes (gb, us, at, au, be,
# br, ca, ch, de, es, fr, in, it, mx, nl, nz, pl, sg, za). We query "us"
# for every company regardless of the alum's own location.
ADZUNA_COUNTRY=us
